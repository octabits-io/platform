{
  "name": "@octabits-io/demo-server",
  "version": "0.0.19",
  "private": true,
  "type": "module",
  "description": "Contact-desk demo API — living documentation and pre-release validation harness for @octabits-io/framework",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.4",
    "@hono/standard-validator": "^0.3.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.9.0",
    "@octabits-io/flow": "^0.12.0",
    "@octabits-io/framework": "workspace:*",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "ai": "^7.0.48",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "hono-openapi": "^1.3.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/json-schema": "^7.0.15",
    "@types/pg": "^8.20.3",
    "openapi-types": "^12.1.3",
    "typescript": "^7.0.2"
  }
}
